---
export interface Props {
  lng: number;
  lat: number;
}

const { lng, lat } = Astro.props;
---

<div id="venue-map" class="maplibre-container" data-lng={lng} data-lat={lat}></div>

<style>
  .maplibre-container {
    width: 100%;
    height: 400px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #d9d9d9;
    position: relative;
  }
</style>

<script>
  import { Map, Marker, NavigationControl } from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  const initMap = () => {
    const container = document.getElementById("venue-map");
    if (!container) return;
    
    // Clear the container in case of HMR (Hot Module Replacement)
    container.innerHTML = "";

    const lng = parseFloat(container.dataset.lng || "77.5642296");
    const lat = parseFloat(container.dataset.lat || "12.9416203");

    const map = new Map({
      container: "venue-map",
      style: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
      center: [lng, lat],
      zoom: 15,
    });

    new Marker()
      .setLngLat([lng, lat])
      .addTo(map);

    map.addControl(new NavigationControl({ showCompass: false }), 'bottom-right');
  };

  initMap();
</script>
